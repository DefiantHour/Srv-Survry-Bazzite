#!/usr/bin/env python3
"""Long-running Linux entry for the SrvSurvey port slice.

Watches Elite journals under the Proton prefix, keeps XDG state warm, and
presents HUD panels when the user has opted in (--allow-present,
SRVSURVEY_ALLOW_PRESENT=1, or allow_present in user config).

This is not the Avalonia / AppImage app yet — it is the native journal +
overlay path that those will call into.
"""

from __future__ import annotations

import sys
from pathlib import Path

RUNTIME = Path(__file__).resolve().parent / "runtime"
sys.path.insert(0, str(RUNTIME))

from config import present_is_allowed  # noqa: E402
from elite import ensure_session_display  # noqa: E402
from host import main  # noqa: E402


def entry(argv: list[str] | None = None) -> int:
    ensure_session_display()
    args = list(sys.argv[1:] if argv is None else argv)
    if "--settings" in args or "-h" in args or "--help" in args:
        return main(args)
    # Default to the watch path so a bare launch is long-running.
    if not any(flag in args for flag in ("--watch", "--present")):
        args = ["--watch", *args]
    # Present when gated; otherwise watch-only.
    cli_allow = "--allow-present" in args
    if (
        "--present" not in args
        and present_is_allowed(cli_allow=cli_allow)
        and "--watch" in args
    ):
        args = ["--present", *args]
    return main(args)


if __name__ == "__main__":
    raise SystemExit(entry())
