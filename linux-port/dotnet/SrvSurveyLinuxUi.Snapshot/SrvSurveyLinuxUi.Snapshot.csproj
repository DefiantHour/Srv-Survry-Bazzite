<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AvaloniaTelemetryEnabled>false</AvaloniaTelemetryEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- Anchored to this file so /home and /var/home (Bazzite symlink) never mix in one restore. -->
    <ProjectReference Include="$(MSBuildThisFileDirectory)../SrvSurveyLinuxUi/SrvSurveyLinuxUi.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" Version="12.1.3" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.3" />
  </ItemGroup>
</Project>
